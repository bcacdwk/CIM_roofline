  "service_modes": [
    {
      "mode_id": "normal_evaluation",
      "bias_load_endpoint": "32活动m=1 cell，VBL0.3V/VWL0.6V/VTBL0.1V，core T2与共享TBL的电流建立/漏电补偿，公共SAR近似部分和",
      "parameter_bindings": {
        "frontend_ns": "cim_frontend_ns",
        "input_ns": "input_step",
        "conversion_ns": "adc_batch",
        "digital_ns": "digital_tick"
      },
      "qualification": "5ns锚定原PH0；原CIM路径与memory路径分离，该5ns不是memory读验实测",
      "source": "RRAM-05 PDF pp.3–4 Figs.3–7; p.7 Figs.16–18"
    },
    {
      "mode_id": "endpoint_verify",
      "bias_load_endpoint": "program后局部退偏，独立T1/IO/BL/SL memory路径逐lane判LRS双门限与HRS门限；128lane/256窗口比较器",
      "parameter_bindings": {
        "frontend_ns": "verify_frontend_ns",
        "input_ns": "input_step",
        "sense_ns": "adc_batch",
        "digital_ns": "digital_tick"
      },
      "qualification": "5ns是独立memory前端参考预算；未由CIM的PH0实测证明。T_B=T_A为共同能力政策依赖而非共享ADC物理依赖。改变同一公共T_I/T_A/T_D会作用所有消费者",
      "source": "RRAM-05 PDF p.3 Fig.3/4; E02/E03/E09; reference design"
    },
    {
      "mode_id": "resident_update",
      "bias_load_endpoint": "128专用驱动，同极性RESET后masked SET；rail在512事务期间保持，完整窗口读验完成后才发布矩阵",
      "parameter_bindings": {
        "setup_ns": "local_setup_ns",
        "return_ns": "local_return_ns",
        "set_pulse_ns": "set_pulse_ns",
        "reset_pulse_ns": "reset_pulse_ns",
        "digital_ns": "digital_tick",
        "rail_setup_ns": "rail_setup_ns",
        "rail_exit_ns": "rail_exit_ns"
      },
      "qualification": "pulse、local偏置和rail只作用更新；端点读验使用endpoint_verify绑定，完整RESET不隐藏",
      "source": "RRAM-01 PDF p.10; RRAM-03 PDF p.5; RRAM-06 PDF pp.1–2; reference design"
    }
  ],
  "range_semantics": {
    "main": "固定组织/128驱动的short/reference/long配对条件：外围能力、局部切换与有限RESET/SET完成预算一并声明；不是实测典型/良率分位/材料快慢物理界。",
