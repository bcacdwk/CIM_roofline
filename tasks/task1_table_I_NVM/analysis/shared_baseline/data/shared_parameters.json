  "field_provenance": {
    "rule": "未单列字段继承所在对象 kind；reported/reported_model 均为文献原值，后者是作者模型而非实测；reference_choice 为本文选择；derived 为公式推导。示意物理输入是参考选择，不是文献原值。",
    "logical_configuration": {
      "B_S_Byte": {
        "kind": "derived",
        "formula": "n_in*b_S"
      },
      "resident_capacity_Byte": {
        "kind": "derived",
        "formula": "n_in*n_out*b_R"
      },
      "output_count": {
        "kind": "derived",
        "formula": "n_out"
      }
    },
    "acim": {
      "adc_total": {
        "kind": "derived",
        "formula": "adc_per_weight_plane*parallel_weight_planes"
      },
      "adc_mux_per_plane": {
        "kind": "derived",
        "formula": "ceil(n_out/adc_per_weight_plane)"
      },
      "input_bit_steps": {
        "kind": "derived",
        "formula": "ceil(8*b_S/input_bits_per_step)"
      },
      "physical_steps_per_vector": {
        "kind": "derived",
        "formula": "input_bit_steps*adc_mux_per_plane"
      },
      "adc_batches_per_vector": {
        "kind": "derived",
        "formula": "physical_steps_per_vector"
      },
      "scalar_conversions_per_vector": {
        "kind": "derived",
        "formula": "adc_batches_per_vector*adc_total"
      },
      "partial_sum_max": {
        "kind": "derived",
        "formula": "rows_per_step for binary products"
      }
    },
    "dcim": {
      "input_bit_steps": {
        "kind": "derived",
        "formula": "ceil(8*b_S/input_bits_per_tick)"
      },
      "row_groups": {
        "kind": "derived",
        "formula": "ceil(n_in/rows_per_group)"
      },
      "output_groups": {
        "kind": "derived",
        "formula": "ceil(n_out/output_lanes)"
      },
      "compute_steps_per_vector": {
        "kind": "derived",
        "formula": "input_bit_steps*row_groups*output_groups"
      }
    },
    "resident": {
      "default_binary_unredundant_completed_Byte_per_parallel_batch": {
        "kind": "derived",
        "formula": "128 physical bits / (8 binary cells per INT8 weight) * b_R, only if all complete together"
      }
    },
    "examples": {
      "inputs": "reference_choice (illustrative only)",
      "B_S_Byte": "derived",
